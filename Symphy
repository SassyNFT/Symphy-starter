services:
  # -------- API (FastAPI Docker Web Service) --------
  - type: web
    name: symphy-api
    env: docker
    rootDir: backend
    dockerfilePath: backend/Dockerfile
    plan: free
    autoDeploy: true
    healthCheckPath: /docs
    envVars:
      - key: PYTHONUNBUFFERED
        value: "1"

  # -------- Frontend (Static Site) --------
  - type: static
    name: symphy-web
    rootDir: frontend
    buildCommand: npm install && npm run build
    staticPublishPath: dist
    envVars:
      - key: NODE_VERSION
        value: "20"
      # This links the frontend to your live API URL automatically
      - key: VITE_API_BASE
        fromService:
          type: web
          name: symphy-api
          property: url
